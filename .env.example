# Built with Spec4 AI - https://spec4.ai
# Backend
DATABASE_URL=
CORS_ORIGIN=
PORT=
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
OPENROUTER_API_KEY=
EXA_API_KEY=

# GROQ_API_KEY and OPENAI_API_KEY are required in every environment
# (production, local development and tests), with no placeholders and no
# opt-out: startup fails naming whichever is missing, and an empty value counts
# as missing. Every pytest run needs the real keys; the `-m live` smoke tests
# remain opt-in and are deselected by default.
#
# Required. Groq's free tier is metered per model (1,000+ requests/day each)
# rather than as one account-wide pool, so every model chain is Groq-first.
GROQ_API_KEY=
# Required. The shared moderation service screens free-form visitor input with
# it; the gate fails closed without it. OpenAI's moderation endpoint is free of
# charge and does not draw on the OpenRouter allowance.
OPENAI_API_KEY=
# Optional — leave blank and Sentry error tracking is skipped entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Frontend
VITE_API_BASE_URL=
# Optional — leave blank and Sentry error tracking is skipped entirely.
VITE_SENTRY_DSN=
