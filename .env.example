# Built with Spec4 AI - https://spec4.ai
# Backend
DATABASE_URL=
CORS_ORIGIN=
PORT=
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
OPENROUTER_API_KEY=
EXA_API_KEY=

# Optional second LLM provider for the tool-use agent's model chain. Groq's
# free tier is metered per model (1,000+ requests/day each) rather than as one
# account-wide pool, so it carries most of the traffic when set. Leave blank
# and the chain falls back to OpenRouter alone.
GROQ_API_KEY=
# Optional — leave blank and Sentry error tracking is skipped entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Frontend
VITE_API_BASE_URL=
# Optional — leave blank and Sentry error tracking is skipped entirely.
VITE_SENTRY_DSN=
