{
  "step": 6,
  "preference_text": "A modern design with selectable light and dark themes.  A look similar to https://exa.ai/",
  "screenshots": [],
  "mock_html": "<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"dark\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Built with Spec4 (BWS4)</title>\n<style>\n  :root{\n    --bg: #0a0a0f;\n    --bg-alt: #101018;\n    --surface: #14141e;\n    --surface-2: #191927;\n    --border: #26263a;\n    --text: #eef0fa;\n    --text-dim: #9b9cb5;\n    --text-faint: #6a6b85;\n    --accent1: #7c5cff;\n    --accent2: #4ea1ff;\n    --accent-grad: linear-gradient(120deg, #7c5cff, #4ea1ff);\n    --success: #34d399;\n    --warn: #f6b93b;\n    --danger: #ff6b6b;\n    --radius: 14px;\n    --shadow: 0 10px 40px rgba(124,92,255,0.12);\n    --mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;\n    --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n  }\n  html[data-theme=\"light\"]{\n    --bg: #f7f7fb;\n    --bg-alt: #ffffff;\n    --surface: #ffffff;\n    --surface-2: #f1f1fa;\n    --border: #e2e2ee;\n    --text: #191926;\n    --text-dim: #55566b;\n    --text-faint: #8a8ba0;\n    --shadow: 0 10px 30px rgba(124,92,255,0.10);\n  }\n  *{ box-sizing: border-box; }\n  html,body{ height:100%; }\n  body{\n    margin:0;\n    background: var(--bg);\n    color: var(--text);\n    font-family: var(--font);\n    line-height:1.5;\n    -webkit-font-smoothing: antialiased;\n    transition: background .25s ease, color .25s ease;\n  }\n  a{ color: inherit; text-decoration:none; }\n  ::selection{ background: rgba(124,92,255,.35); }\n\n  /* ===== Top nav ===== */\n  .topnav{\n    position: sticky; top:0; z-index: 50;\n    display:flex; align-items:center; justify-content:space-between;\n    padding: 14px 28px;\n    background: color-mix(in srgb, var(--bg) 85%, transparent);\n    backdrop-filter: blur(14px);\n    border-bottom: 1px solid var(--border);\n  }\n  .brand{ display:flex; align-items:center; gap:10px; }\n  .brand-mark{\n    font-weight:800; font-size:18px; letter-spacing:.3px;\n    background: var(--accent-grad);\n    -webkit-background-clip:text; background-clip:text; color:transparent;\n  }\n  .brand-sub{ font-size:11px; color: var(--text-faint); font-family: var(--mono); }\n  .nav-links{ display:flex; gap:4px; align-items:center; }\n  .nav-links button{\n    background:none; border:none; color: var(--text-dim);\n    font-size:14px; padding:8px 14px; border-radius: 999px; cursor:pointer;\n    font-family: var(--font); transition: all .15s ease;\n  }\n  .nav-links button:hover{ color: var(--text); background: var(--surface-2); }\n  .nav-links button.active{ color: var(--text); background: var(--surface-2); box-shadow: inset 0 0 0 1px var(--border); }\n  .nav-right{ display:flex; align-items:center; gap:10px; }\n  .theme-btn{\n    width:36px; height:36px; border-radius: 10px; border:1px solid var(--border);\n    background: var(--surface); color: var(--text); cursor:pointer; font-size:16px;\n    display:flex; align-items:center; justify-content:center;\n  }\n  .theme-btn:hover{ border-color: var(--accent2); }\n\n  /* ===== Screens ===== */\n  .screen{ display:none; max-width: 1180px; margin: 0 auto; padding: 40px 28px 90px; animation: fadeIn .35s ease; }\n  .screen.active{ display:block; }\n  @keyframes fadeIn{ from{opacity:0; transform: translateY(6px);} to{opacity:1; transform:none;} }\n\n  .tag{\n    display:inline-flex; align-items:center; gap:6px;\n    font-family: var(--mono); font-size:11px; letter-spacing:.5px; text-transform:uppercase;\n    padding: 4px 10px; border-radius: 999px; border:1px solid var(--border); color: var(--text-dim);\n    background: var(--surface-2);\n  }\n  .tag.dot::before{ content:''; width:6px; height:6px; border-radius:50%; background: var(--accent2); }\n\n  /* ===== Landing ===== */\n  .hero{ padding: 60px 0 40px; text-align:center; }\n  .hero h1{\n    font-size: 44px; margin: 18px 0 14px; letter-spacing:-1px;\n    background: var(--accent-grad); -webkit-background-clip:text; background-clip:text; color:transparent;\n  }\n  .hero p{ max-width: 640px; margin: 0 auto; color: var(--text-dim); font-size:16px; }\n  .hero-badges{ display:flex; gap:10px; justify-content:center; margin-top:22px; flex-wrap:wrap; }\n\n  .section-heading{ display:flex; align-items:baseline; justify-content:space-between; margin: 46px 0 18px; }\n  .section-heading h2{ font-size:20px; margin:0; }\n  .section-heading span{ color: var(--text-faint); font-size:13px; font-family: var(--mono); }\n\n  .app-grid{ display:grid; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); gap:18px; }\n  .app-card{\n    background: var(--surface); border:1px solid var(--border); border-radius: var(--radius);\n    padding: 22px; cursor:pointer; transition: all .2s ease; position:relative; overflow:hidden;\n  }\n  .app-card::before{\n    content:''; position:absolute; inset:0; background: var(--accent-grad); opacity:0;\n    transition: opacity .2s ease;\n  }\n  .app-card:hover{ transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--accent1); }\n  .app-card.disabled{ opacity:.55; cursor:not-allowed; }\n  .app-card.disabled:hover{ transform:none; box-shadow:none; border-color: var(--border); }\n  .app-card h3{ margin: 10px 0 8px; font-size:17px; }\n  .app-card p{ color: var(--text-dim); font-size:13.5px; margin: 0 0 16px; }\n  .app-card .go{ font-size:13px; font-weight:600; color: var(--accent2); }\n  .app-card .go::after{ content:' \u2192'; }\n\n  .footnote{\n    margin-top: 60px; padding-top: 20px; border-top: 1px solid var(--border);\n    color: var(--text-faint); font-size:12.5px; text-align:center; font-family: var(--mono);\n  }\n\n  /* ===== Screen headers (RAG/Tool/Console) ===== */\n  .screen-head{ margin-bottom: 30px; }\n  .screen-head h1{ font-size:28px; margin: 8px 0 8px; }\n  .screen-head p{ color: var(--text-dim); font-size:14.5px; max-width: 720px; }\n  .screen-head .tags{ display:flex; gap:8px; margin-bottom: 6px; flex-wrap:wrap; }\n\n  .layout-2col{ display:grid; grid-template-columns: 320px 1fr; gap:22px; align-items:start; }\n  @media (max-width: 900px){ .layout-2col{ grid-template-columns: 1fr; } }\n\n  .card{\n    background: var(--surface); border:1px solid var(--border); border-radius: var(--radius);\n    padding: 20px;\n  }\n  .card h4{ margin:0 0 12px; font-size:14px; text-transform:uppercase; letter-spacing:.5px; color: var(--text-dim); }\n\n  /* ===== Dataset browser ===== */\n  .doc-item{ border:1px solid var(--border); border-radius:10px; margin-bottom:10px; overflow:hidden; }\n  .doc-head{\n    display:flex; justify-content:space-between; align-items:center; padding:12px 14px;\n    cursor:pointer; background: var(--surface-2);\n  }\n  .doc-head strong{ font-size:13.5px; }\n  .doc-head span{ font-size:11px; color: var(--text-faint); font-family: var(--mono); }\n  .doc-body{ max-height:0; overflow:hidden; transition: max-height .25s ease; }\n  .doc-body p{ padding: 12px 14px; margin:0; font-size:13px; color: var(--text-dim); }\n  .doc-item.open .doc-body{ max-height: 240px; }\n  .doc-item.open .chevron{ transform: rotate(90deg); }\n  .chevron{ transition: transform .2s ease; color: var(--text-faint); }\n\n  /* ===== RAG form / chips ===== */\n  .chip-row{ display:flex; flex-wrap:wrap; gap:8px; margin: 10px 0 16px; }\n  .chip{\n    font-size:12.5px; padding:7px 12px; border-radius: 999px; border:1px solid var(--border);\n    background: var(--surface-2); color: var(--text-dim); cursor:pointer; transition:.15s;\n  }\n  .chip:hover{ border-color: var(--accent1); color: var(--text); }\n\n  .qform{ display:flex; gap:10px; }\n  .qform input[type=text]{\n    flex:1; padding:13px 16px; border-radius: 10px; border:1px solid var(--border);\n    background: var(--bg-alt); color: var(--text); font-size:14.5px;\n  }\n  .qform input[type=text]:focus{ outline:none; border-color: var(--accent1); }\n  .btn{\n    padding: 12px 20px; border-radius:10px; border:none; cursor:pointer; font-weight:600; font-size:14px;\n    background: var(--accent-grad); color:#fff; transition: transform .15s ease, opacity .15s;\n    white-space:nowrap;\n  }\n  .btn:hover{ transform: translateY(-1px); }\n  .btn:disabled{ opacity:.6; cursor:not-allowed; transform:none; }\n  .btn.secondary{ background: var(--surface-2); color: var(--text); border:1px solid var(--border); }\n  .btn.small{ padding: 8px 14px; font-size:12.5px; }\n\n  .result-panel{ margin-top: 22px; }\n  .stage-line{ display:flex; gap:10px; align-items:center; margin-bottom: 14px; font-size:13px; color: var(--text-faint); font-family: var(--mono); }\n  .spinner{\n    width:14px; height:14px; border-radius:50%; border:2px solid var(--border); border-top-color: var(--accent2);\n    animation: spin .7s linear infinite;\n  }\n  @keyframes spin{ to{ transform: rotate(360deg); } }\n\n  .answer-card{\n    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);\n    padding: 22px; box-shadow: var(--shadow);\n  }\n  .answer-card.warn{ border-color: var(--warn); box-shadow: 0 10px 40px rgba(246,185,59,.12); }\n  .answer-card.err{ border-color: var(--danger); box-shadow: 0 10px 40px rgba(255,107,107,.12); }\n  .answer-meta{ display:flex; align-items:center; gap:10px; margin-bottom: 14px; flex-wrap:wrap; }\n  .confidence{\n    font-family: var(--mono); font-size:11.5px; padding:4px 10px; border-radius:999px;\n  }\n  .confidence.high{ background: rgba(52,211,153,.14); color: var(--success); border:1px solid rgba(52,211,153,.3); }\n  .confidence.low{ background: rgba(246,185,59,.14); color: var(--warn); border:1px solid rgba(246,185,59,.3); }\n  .answer-text{ font-size:15.5px; margin: 6px 0 20px; }\n  .answer-text .cite{\n    font-family: var(--mono); font-size:11.5px; color: var(--accent2); cursor:default; vertical-align: super;\n  }\n  .warning-banner{\n    display:flex; gap:10px; align-items:flex-start; background: rgba(246,185,59,.1); border:1px solid rgba(246,185,59,.35);\n    padding: 12px 14px; border-radius:10px; margin-bottom:18px; font-size:13px; color: var(--warn);\n  }\n  .passages-block h5{ font-size:12.5px; text-transform:uppercase; letter-spacing:.5px; color: var(--text-dim); margin: 0 0 10px; }\n  .passage{\n    border:1px solid var(--border); border-radius:10px; padding: 12px 14px; margin-bottom: 10px; background: var(--surface-2);\n  }\n  .passage-top{ display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; gap:10px; }\n  .passage-top strong{ font-size:13px; }\n  .score-badge{ font-family: var(--mono); font-size:11px; padding:2px 8px; border-radius:6px; background: var(--bg); border:1px solid var(--border); color: var(--text-faint); }\n  .passage p{ margin:0; font-size:12.5px; color: var(--text-dim); }\n\n  /* ===== Tool use screen ===== */\n  .steps{ display:flex; gap:14px; margin: 18px 0 22px; flex-wrap:wrap; }\n  .step{\n    flex:1; min-width:170px; border:1px solid var(--border); border-radius:10px; padding: 14px;\n    background: var(--surface); font-size:13px; color: var(--text-faint); position:relative;\n  }\n  .step .num{ font-family: var(--mono); font-size:11px; color: var(--text-faint); }\n  .step .label{ display:block; margin-top:6px; color: var(--text-dim); font-weight:600; }\n  .step.active{ border-color: var(--accent1); color: var(--text); box-shadow: 0 0 0 1px var(--accent1) inset; }\n  .step.active .label{ color: var(--text); }\n  .step.done{ border-color: var(--success); }\n  .step.done .label{ color: var(--success); }\n\n  .routing-line{\n    font-family: var(--mono); font-size:12px; color: var(--accent2); margin-bottom: 14px;\n    display:flex; gap:8px; align-items:center;\n  }\n  .result-list{ display:flex; flex-direction:column; gap:10px; margin-top: 8px; }\n  .result-item{\n    border:1px solid var(--border); border-radius:10px; padding:14px; background: var(--surface-2);\n    display:flex; gap:14px; align-items:flex-start;\n  }\n  .rank-badge{\n    font-family: var(--mono); font-size:12px; color:#fff; background: var(--accent-grad);\n    width:26px; height:26px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;\n  }\n  .result-item h5{ margin:0 0 4px; font-size:14px; }\n  .result-item p{ margin:0 0 6px; font-size:13px; color: var(--text-dim); }\n  .source-label{ font-family: var(--mono); font-size:11px; color: var(--text-faint); }\n\n  /* ===== Console screen ===== */\n  .console-grid{ display:grid; grid-template-columns: 1.1fr 1fr; gap:22px; align-items:start; }\n  @media (max-width: 980px){ .console-grid{ grid-template-columns: 1fr; } }\n  select, textarea{\n    width:100%; padding:11px 13px; border-radius:10px; border:1px solid var(--border);\n    background: var(--bg-alt); color: var(--text); font-family: var(--font); font-size:13.5px; resize:vertical;\n  }\n  select:focus, textarea:focus{ outline:none; border-color: var(--accent1); }\n  label.field-label{ display:block; font-size:12px; color: var(--text-faint); margin: 14px 0 6px; text-transform:uppercase; letter-spacing:.4px; }\n  .console-actions{ display:flex; gap:10px; margin-top:16px; align-items:center; flex-wrap:wrap; }\n  .response-box{\n    margin-top:18px; background: var(--bg-alt); border:1px solid var(--border); border-radius:10px;\n    padding:16px; font-family: var(--mono); font-size:12.5px; color: var(--text-dim); white-space:pre-wrap; min-height:70px;\n  }\n  .response-box.err{ border-color: var(--danger); color: var(--danger); }\n\n  .usage-item{ margin-bottom:16px; }\n  .usage-top{ display:flex; justify-content:space-between; font-size:12.5px; margin-bottom:6px; }\n  .usage-top .cap-name{ color: var(--text-dim); }\n  .usage-top .cap-nums{ font-family: var(--mono); color: var(--text-faint); }\n  .bar-track{ height:8px; border-radius:999px; background: var(--surface-2); border:1px solid var(--border); overflow:hidden; }\n  .bar-fill{ height:100%; background: var(--accent-grad); border-radius:999px; transition: width .4s ease; }\n  .bar-fill.warn{ background: linear-gradient(120deg, #f6b93b, #ff6b6b); }\n\n  table.log-table{ width:100%; border-collapse: collapse; margin-top: 10px; font-size:12.5px; }\n  table.log-table th{ text-align:left; color: var(--text-faint); font-weight:600; padding: 8px 10px; border-bottom:1px solid var(--border); font-size:11px; text-transform:uppercase; letter-spacing:.4px; }\n  table.log-table td{ padding: 9px 10px; border-bottom:1px solid var(--border); color: var(--text-dim); }\n  table.log-table tr:last-child td{ border-bottom:none; }\n  .app-pill{ font-family: var(--mono); font-size:11px; padding:2px 8px; border-radius:6px; background: var(--surface-2); border:1px solid var(--border); }\n  .empty-state{ color: var(--text-faint); font-size:13px; text-align:center; padding: 24px 0; }\n\n  footer.app-footer{\n    border-top:1px solid var(--border); text-align:center; padding: 18px; color: var(--text-faint);\n    font-size:12px; font-family: var(--mono);\n  }\n</style>\n</head>\n<body>\n\n<header class=\"topnav\">\n  <div class=\"brand\">\n    <span class=\"brand-mark\">BWS4</span>\n    <span class=\"brand-sub\">/ Built with Spec4</span>\n  </div>\n  <nav class=\"nav-links\" id=\"navLinks\">\n    <button data-target=\"screen-landing\" class=\"active\">Home</button>\n    <button data-target=\"screen-rag\">RAG Example</button>\n    <button data-target=\"screen-tooluse\">Tool-Use Example</button>\n    <button data-target=\"screen-console\">Framework Console</button>\n  </nav>\n  <div class=\"nav-right\">\n    <button class=\"theme-btn\" id=\"themeBtn\" title=\"Toggle theme\">\ud83c\udf19</button>\n  </div>\n</header>\n\n<main>\n\n  <!-- ================= LANDING SCREEN ================= -->\n  <section class=\"screen active\" id=\"screen-landing\">\n    <div class=\"hero\">\n      <span class=\"tag dot\">Teaching framework \u00b7 dogfooded on itself</span>\n      <h1>Built with Spec4 (BWS4)</h1>\n      <p>BWS4 is a framework and a growing collection of example apps that demonstrate what Spec4 can build. Every example below \u2014 including this landing page \u2014 was built <em>using</em> Spec4, so you're looking at a live demonstration, not a slide deck.</p>\n      <div class=\"hero-badges\">\n        <span class=\"tag\">Retrieval-Augmented Generation</span>\n        <span class=\"tag\">Tool Use / Function Calling</span>\n        <span class=\"tag\">Shared Framework Services</span>\n      </div>\n    </div>\n\n    <div class=\"section-heading\">\n      <h2>Example App Directory</h2>\n      <span>derived from the current set of available example apps</span>\n    </div>\n    <div class=\"app-grid\" id=\"appDirectory\">\n      <!-- populated by JS -->\n    </div>\n\n    <div class=\"footnote\">Every app in this directory shares the same shared services, navigation, and visual language \u2014 consistent by design.</div>\n  </section>\n\n  <!-- ================= RAG SCREEN ================= -->\n  <section class=\"screen\" id=\"screen-rag\">\n    <div class=\"screen-head\">\n      <div class=\"tags\">\n        <span class=\"tag dot\">Pattern: Retrieval-Augmented Generation</span>\n        <span class=\"tag\">Reference dataset: Space Exploration Facts</span>\n      </div>\n      <h1>RAG Example App</h1>\n      <p>Ask a question and watch BWS4 retrieve supporting passages from a small public dataset, then generate an answer grounded in what it found. Both the retrieved passages and the generated answer are shown, so the retrieval \u2192 generation chain stays visible.</p>\n    </div>\n\n    <div class=\"layout-2col\">\n      <div class=\"card\" id=\"datasetCard\">\n        <h4>Reference Dataset (5 documents)</h4>\n        <div id=\"docList\"></div>\n      </div>\n\n      <div>\n        <div class=\"card\">\n          <h4>Ask a question</h4>\n          <div class=\"chip-row\" id=\"ragChips\"></div>\n          <form class=\"qform\" id=\"ragForm\">\n            <input type=\"text\" id=\"ragInput\" placeholder=\"e.g. When did Voyager 1 launch and what is it doing now?\" />\n            <button class=\"btn\" type=\"submit\" id=\"ragSubmit\">Ask</button>\n          </form>\n        </div>\n\n        <div class=\"result-panel\" id=\"ragResultPanel\"></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ================= TOOL USE SCREEN ================= -->\n  <section class=\"screen\" id=\"screen-tooluse\">\n    <div class=\"screen-head\">\n      <div class=\"tags\">\n        <span class=\"tag dot\">Pattern: Tool Use / Function Calling</span>\n        <span class=\"tag\">Capability: Live search tool</span>\n      </div>\n      <h1>Tool-Use Example App</h1>\n      <p>Submit a query that needs current information. The agent decides it needs outside data, calls a search tool, then synthesizes an answer from the returned results \u2014 illustrating how an agent incorporates external information mid-response.</p>\n    </div>\n\n    <div class=\"card\">\n      <h4>Ask something that needs a live lookup</h4>\n      <div class=\"chip-row\" id=\"toolChips\"></div>\n      <form class=\"qform\" id=\"toolForm\">\n        <input type=\"text\" id=\"toolInput\" placeholder=\"e.g. What's the latest Spec4 release?\" />\n        <button class=\"btn\" type=\"submit\" id=\"toolSubmit\">Run agent</button>\n      </form>\n    </div>\n\n    <div class=\"result-panel\" id=\"toolResultPanel\"></div>\n  </section>\n\n  <!-- ================= CONSOLE SCREEN ================= -->\n  <section class=\"screen\" id=\"screen-console\">\n    <div class=\"screen-head\">\n      <div class=\"tags\">\n        <span class=\"tag dot\">Audience: Spec4 team / maintainers</span>\n        <span class=\"tag\">Shared Framework Services</span>\n      </div>\n      <h1>Framework Services Console</h1>\n      <p>Every example app calls the same three shared capabilities \u2014 text generation, text representation, and data storage/retrieval \u2014 through one consistent interface. Test that interface directly, watch usage limits move, and see requests logged across apps.</p>\n    </div>\n\n    <div class=\"console-grid\">\n      <div class=\"card\">\n        <h4>Request tester</h4>\n        <label class=\"field-label\">Request type</label>\n        <select id=\"reqType\">\n          <option value=\"generation\">Text generation</option>\n          <option value=\"representation\">Text representation</option>\n          <option value=\"storage\">Data storage / retrieval</option>\n        </select>\n        <label class=\"field-label\">Request payload</label>\n        <textarea id=\"reqPayload\" rows=\"3\" placeholder=\"Prompt, text to represent, or record to store...\">Summarize how BWS4 uses Spec4 to teach agentic patterns.</textarea>\n        <div class=\"console-actions\">\n          <button class=\"btn\" id=\"sendReq\">Send request</button>\n          <button class=\"btn secondary small\" id=\"simulateLimit\">Simulate limit reached</button>\n        </div>\n        <div class=\"response-box\" id=\"responseBox\">Response will appear here once a request is sent.</div>\n      </div>\n\n      <div class=\"card\">\n        <h4>Usage limits (free-tier, resets daily)</h4>\n        <div id=\"usageList\"></div>\n      </div>\n    </div>\n\n    <div class=\"card\" style=\"margin-top:22px;\">\n      <h4>Recent cross-app request log</h4>\n      <div id=\"logWrap\"></div>\n    </div>\n  </section>\n\n</main>\n\n<footer class=\"app-footer\">BWS4 \u2014 every screen, pattern demo, and shared service above was built with Spec4.</footer>\n\n<script>\n(function(){\n\n  /* ---------------- THEME ---------------- */\n  const themeBtn = document.getElementById('themeBtn');\n  function applyTheme(t){\n    document.documentElement.setAttribute('data-theme', t);\n    themeBtn.textContent = t === 'dark' ? '\ud83c\udf19' : '\u2600\ufe0f';\n    localStorage.setItem('bws4-theme', t);\n  }\n  applyTheme(localStorage.getItem('bws4-theme') || 'dark');\n  themeBtn.addEventListener('click', ()=>{\n    const cur = document.documentElement.getAttribute('data-theme');\n    applyTheme(cur === 'dark' ? 'light' : 'dark');\n  });\n\n  /* ---------------- NAV ---------------- */\n  const navBtns = document.querySelectorAll('.nav-links button');\n  navBtns.forEach(btn=>{\n    btn.addEventListener('click', ()=>{\n      navBtns.forEach(b=>b.classList.remove('active'));\n      btn.classList.add('active');\n      document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));\n      document.getElementById(btn.dataset.target).classList.add('active');\n      window.scrollTo({top:0, behavior:'smooth'});\n    });\n  });\n  function goTo(id){\n    navBtns.forEach(b=>b.classList.toggle('active', b.dataset.target === id));\n    document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));\n    document.getElementById(id).classList.add('active');\n    window.scrollTo({top:0, behavior:'smooth'});\n  }\n\n  /* ---------------- APP DIRECTORY ---------------- */\n  const apps = [\n    { name:'RAG Example App', desc:'Ask questions grounded in a small public dataset using retrieval-augmented generation.', tag:'Retrieval-Augmented Generation', target:'screen-rag', status:'live' },\n    { name:'Tool-Use Example App', desc:'Watch an agent call a live search tool mid-response to pull in up-to-date information.', tag:'Tool Use / Function Calling', target:'screen-tooluse', status:'live' },\n    { name:'Framework Services Console', desc:'Inspect the shared generation, representation, and storage services every app is built on.', tag:'Shared Services Showcase', target:'screen-console', status:'live' },\n    { name:'Multi-Agent Planner', desc:'Multiple cooperating agents break a goal into sub-tasks and hand off work between them.', tag:'Multi-Agent Orchestration', target:null, status:'coming soon' },\n    { name:'Memory & Personalization', desc:'An agent that remembers prior visits and adapts its responses across sessions.', tag:'Long-Term Memory', target:null, status:'coming soon' }\n  ];\n  const dirEl = document.getElementById('appDirectory');\n  apps.forEach(a=>{\n    const card = document.createElement('div');\n    card.className = 'app-card' + (a.status !== 'live' ? ' disabled' : '');\n    card.innerHTML = `\n      <span class=\"tag dot\">${a.tag}</span>\n      <h3>${a.name}</h3>\n      <p>${a.desc}</p>\n      <div class=\"go\">${a.status === 'live' ? 'Open example' : 'Coming soon'}</div>\n    `;\n    if(a.status === 'live'){\n      card.addEventListener('click', ()=> goTo(a.target));\n    }\n    dirEl.appendChild(card);\n  });\n\n  /* ---------------- SHARED \"SERVICE\" STATE (mirrors Shared_Framework_Services) ---------------- */\n  const usage = {\n    generation: { label:'Text generation', used: 42, cap: 100 },\n    representation: { label:'Text representation', used: 15, cap: 50 },\n    storage: { label:'Data storage / retrieval', used: 128, cap: 300 },\n    search: { label:'Search tool (Tool-Use app)', used: 9, cap: 30 }\n  };\n  const logs = []; // ServiceLogEntry[]\n\n  function nowStr(){\n    const d = new Date();\n    return d.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit', second:'2-digit'});\n  }\n  function pushLog(app, capability, summary){\n    logs.unshift({ time: nowStr(), app, capability, summary });\n    if(logs.length > 8) logs.pop();\n    renderLog();\n  }\n  function bump(capKey, amount){\n    const u = usage[capKey];\n    u.used = Math.min(u.cap, u.used + amount);\n    renderUsage();\n  }\n  function isExhausted(capKey){\n    return usage[capKey].used >= usage[capKey].cap;\n  }\n\n  function renderUsage(){\n    const wrap = document.getElementById('usageList');\n    wrap.innerHTML = '';\n    Object.keys(usage).forEach(key=>{\n      const u = usage[key];\n      const pct = Math.round((u.used / u.cap) * 100);\n      const warnState = pct >= 85;\n      const item = document.createElement('div');\n      item.className = 'usage-item';\n      item.innerHTML = `\n        <div class=\"usage-top\">\n          <span class=\"cap-name\">${u.label}</span>\n          <span class=\"cap-nums\">${u.used} / ${u.cap}</span>\n        </div>\n        <div class=\"bar-track\"><div class=\"bar-fill ${warnState ? 'warn' : ''}\" style=\"width:${pct}%\"></div></div>\n      `;\n      wrap.appendChild(item);\n    });\n  }\n  function renderLog(){\n    const wrap = document.getElementById('logWrap');\n    if(logs.length === 0){\n      wrap.innerHTML = `<div class=\"empty-state\">No requests yet \u2014 try the RAG or Tool-Use example apps, or send a test request above.</div>`;\n      return;\n    }\n    let rows = logs.map(l => `\n      <tr>\n        <td>${l.time}</td>\n        <td><span class=\"app-pill\">${l.app}</span></td>\n        <td>${l.capability}</td>\n        <td>${l.summary}</td>\n      </tr>`).join('');\n    wrap.innerHTML = `\n      <table class=\"log-table\">\n        <thead><tr><th>Time</th><th>App</th><th>Capability</th><th>Summary</th></tr></thead>\n        <tbody>${rows}</tbody>\n      </table>`;\n  }\n  renderUsage(); renderLog();\n\n  /* ================= RAG EXAMPLE APP ================= */\n  const dataset = [\n    { title:'Voyager 1: Interstellar Explorer', source:'NASA JPL mission summary',\n      text:'Voyager 1 launched on September 5, 1977. It became the first human-made object to enter interstellar space in August 2012 and continues to send data back to Earth over the Deep Space Network, now more than 24 billion kilometers from home.' },\n    { title:'Apollo 11 Moon Landing', source:'NASA History Office',\n      text:'Apollo 11 launched on July 16, 1969. Neil Armstrong and Buzz Aldrin became the first humans to walk on the Moon on July 20, 1969, while Michael Collins orbited above in the command module.' },\n    { title:'The International Space Station', source:'ISS Program overview',\n      text:'The International Space Station has been continuously occupied since November 2000, serving as a microgravity laboratory operated jointly by NASA, Roscosmos, ESA, JAXA, and CSA.' },\n    { title:'James Webb Space Telescope', source:'JWST mission fact sheet',\n      text:'Launched in December 2021, the James Webb Space Telescope observes the universe primarily in infrared light, letting it study the first galaxies formed after the Big Bang and the atmospheres of distant exoplanets.' },\n    { title:'Mars Rover Missions', source:'Mars Exploration Program brief',\n      text:\"NASA's Perseverance rover landed in Jezero Crater in February 2021 to search for signs of ancient microbial life and collect rock samples for eventual return to Earth, building on the earlier work of Curiosity and Spirit/Opportunity.\" }\n  ];\n\n  const docList = document.getElementById('docList');\n  dataset.forEach((doc, i)=>{\n    const item = document.createElement('div');\n    item.className = 'doc-item';\n    item.innerHTML = `\n      <div class=\"doc-head\">\n        <div><strong>${doc.title}</strong><br><span>${doc.source}</span></div>\n        <span class=\"chevron\">\u25b6</span>\n      </div>\n      <div class=\"doc-body\"><p>${doc.text}</p></div>\n    `;\n    item.querySelector('.doc-head').addEventListener('click', ()=> item.classList.toggle('open'));\n    docList.appendChild(item);\n  });\n\n  const ragQuestions = [\n    'When did Voyager 1 launch and what is it doing now?',\n    'What did the Apollo 11 mission accomplish?',\n    'What does the James Webb Space Telescope observe?',\n    \"What's the best pizza topping?\"\n  ];\n  const ragChipsEl = document.getElementById('ragChips');\n  ragQuestions.forEach(q=>{\n    const c = document.createElement('span');\n    c.className = 'chip';\n    c.textContent = q;\n    c.addEventListener('click', ()=>{ document.getElementById('ragInput').value = q; });\n    ragChipsEl.appendChild(c);\n  });\n\n  const STOPWORDS = new Set(['what','when','did','the','is','are','a','an','of','and','to','in','on','for','was','were','does','do','it','its','with','how','who','which']);\n  function scorePassage(question, doc){\n    const words = question.toLowerCase().replace(/[^a-z0-9\\s]/g,'').split(/\\s+/).filter(w=>w && !STOPWORDS.has(w));\n    const hay = (doc.title + ' ' + doc.text).toLowerCase();\n    let score = 0;\n    words.forEach(w=>{ if(hay.includes(w)) score++; });\n    return score;\n  }\n\n  const ragForm = document.getElementById('ragForm');\n  const ragPanel = document.getElementById('ragResultPanel');\n\n  ragForm.addEventListener('submit', function(e){\n    e.preventDefault();\n    const question = document.getElementById('ragInput').value.trim();\n    if(!question) return;\n    const submitBtn = document.getElementById('ragSubmit');\n    submitBtn.disabled = true;\n\n    if(isExhausted('generation')){\n      ragPanel.innerHTML = `\n        <div class=\"answer-card err\">\n          <div class=\"answer-meta\"><span class=\"tag\" style=\"border-color:var(--danger); color:var(--danger);\">Service unavailable</span></div>\n          <p style=\"margin:0;\">Text generation capability has hit its free-tier usage limit for today. This demonstration is temporarily unavailable \u2014 try again later, or reset the limit from the Framework Console.</p>\n        </div>`;\n      submitBtn.disabled = false;\n      return;\n    }\n\n    ragPanel.innerHTML = `<div class=\"stage-line\"><span class=\"spinner\"></span> Retrieving passages from the reference dataset\u2026</div>`;\n\n    setTimeout(()=>{\n      ragPanel.innerHTML = `<div class=\"stage-line\"><span class=\"spinner\"></span> Grounding a generated answer in the retrieved passages\u2026</div>`;\n\n      setTimeout(()=>{\n        const scored = dataset.map(d => ({ ...d, score: scorePassage(question, d) }))\n                               .sort((a,b)=> b.score - a.score);\n        const top = scored.slice(0,3);\n        const maxScore = top[0].score;\n        const lowRelevance = maxScore === 0;\n\n        let answerText, confidenceClass, confidenceLabel;\n        if(lowRelevance){\n          confidenceClass = 'low'; confidenceLabel = 'Low confidence \u00b7 weak grounding';\n          answerText = `I couldn't find strong support for this in the BWS4 reference dataset (space exploration facts). The closest passages are shown below for transparency, but they don't clearly relate to your question, so treat this answer as ungrounded speculation rather than a retrieval-backed response.`;\n        } else {\n          confidenceClass = 'high'; confidenceLabel = 'Grounded in ' + top.filter(t=>t.score>0).length + ' retrieved passage(s)';\n          const primary = top[0];\n          const secondary = top[1] && top[1].score > 0 ? top[1] : null;\n          answerText = `Based on the retrieved passages, ${primary.text}<span class=\"cite\">[1]</span>` +\n            (secondary ? ` Additionally, ${secondary.text.charAt(0).toLowerCase()+secondary.text.slice(1)}<span class=\"cite\">[2]</span>` : '');\n        }\n\n        const passagesHtml = top.map((p,idx) => `\n          <div class=\"passage\">\n            <div class=\"passage-top\">\n              <strong>[${idx+1}] ${p.title}</strong>\n              <span class=\"score-badge\">match score: ${p.score}</span>\n            </div>\n            <p>${p.text} <span class=\"source-label\">\u2014 ${p.source}</span></p>\n          </div>\n        `).join('');\n\n        ragPanel.innerHTML = `\n          <div class=\"answer-card ${lowRelevance ? 'warn' : ''}\">\n            <div class=\"answer-meta\">\n              <span class=\"tag dot\">Question: \u201c${question}\u201d</span>\n              <span class=\"confidence ${confidenceClass}\">${confidenceLabel}</span>\n            </div>\n            ${lowRelevance ? `<div class=\"warning-banner\">\u26a0 Dataset gap detected: retrieved passages have little topical overlap with this question. Retrieval-augmented answers are only as good as the dataset behind them.</div>` : ''}\n            <div class=\"answer-text\">${answerText}</div>\n            <div class=\"passages-block\">\n              <h5>Retrieved passages</h5>\n              ${passagesHtml}\n            </div>\n          </div>\n        `;\n        submitBtn.disabled = false;\n        bump('generation', 1);\n        bump('representation', 1);\n        pushLog('RAG Example App', 'Text generation', `Answered: \u201c${question.slice(0,40)}${question.length>40?'\u2026':''}\u201d`);\n        pushLog('RAG Example App', 'Text representation', 'Embedded question for passage similarity scoring');\n      }, 700);\n    }, 650);\n  });\n\n  /* ================= TOOL USE EXAMPLE APP ================= */\n  const toolQueries = [\n    'What is the latest Spec4 release?',\n    'Current Mars rover mission status',\n    'Recent breakthroughs in agentic AI frameworks'\n  ];\n  const toolChipsEl = document.getElementById('toolChips');\n  toolQueries.forEach(q=>{\n    const c = document.createElement('span');\n    c.className = 'chip';\n    c.textContent = q;\n    c.addEventListener('click', ()=>{ document.getElementById('toolInput').value = q; });\n    toolChipsEl.appendChild(c);\n  });\n\n  const searchFixtures = {\n    'what is the latest spec4 release?': [\n      { title:'Spec4 v0.9 \u2014 Agent Composition Update', summary:'Adds first-class support for composing multiple example-app agents from shared spec files, plus a new tool-registration API.', source:'spec4.dev/changelog' },\n      { title:'Spec4 Release Notes Archive', summary:'Full history of Spec4 releases, including the initial public preview focused on retrieval and tool-use patterns.', source:'github.com/spec4/spec4' },\n      { title:'Community Notes: Upgrading to Spec4 v0.9', summary:'Migration tips from developers who upgraded example apps built on earlier Spec4 versions.', source:'community.spec4.dev' }\n    ],\n    'current mars rover mission status': [\n      { title:'Perseverance Rover Mission Updates', summary:'Perseverance continues sample collection in Jezero Crater and is caching samples for a future Mars Sample Return mission.', source:'mars.nasa.gov' },\n      { title:'Curiosity Rover: Still Roving', summary:'Curiosity remains active in Gale Crater, recently investigating sulfur-bearing rock formations.', source:'mars.nasa.gov' },\n      { title:'Ingenuity Helicopter Program Wrap-Up', summary:'The Ingenuity helicopter concluded flight operations after exceeding its planned mission scope by dozens of flights.', source:'jpl.nasa.gov' }\n    ]\n  };\n  function fallbackResults(query){\n    return [\n      { title:`Overview: ${query}`, summary:`A general summary of current information related to \"${query}\", aggregated from public web sources.`, source:'web search (general)' },\n      { title:`Recent discussion on \"${query}\"`, summary:'Community and news commentary touching on this topic from the last few months.', source:'web search (news)' },\n      { title:`Reference material for \"${query}\"`, summary:'Background material useful for grounding an agent response on this topic.', source:'web search (reference)' }\n    ];\n  }\n\n  const toolForm = document.getElementById('toolForm');\n  const toolPanel = document.getElementById('toolResultPanel');\n\n  toolForm.addEventListener('submit', function(e){\n    e.preventDefault();\n    const query = document.getElementById('toolInput').value.trim();\n    if(!query) return;\n    const submitBtn = document.getElementById('toolSubmit');\n    submitBtn.disabled = true;\n\n    if(isExhausted('search')){\n      toolPanel.innerHTML = `\n        <div class=\"answer-card err\">\n          <div class=\"answer-meta\"><span class=\"tag\" style=\"border-color:var(--danger); color:var(--danger);\">Tool unavailable</span></div>\n          <p style=\"margin:0;\">The search tool has hit its free-tier usage limit for today. The agent cannot perform a live lookup right now \u2014 try again later.</p>\n        </div>`;\n      submitBtn.disabled = false;\n      return;\n    }\n\n    const stepsHtml = `\n      <div class=\"steps\" id=\"toolSteps\">\n        <div class=\"step\" data-step=\"1\"><span class=\"num\">01</span><span class=\"label\">Parsing request</span></div>\n        <div class=\"step\" data-step=\"2\"><span class=\"num\">02</span><span class=\"label\">Calling search tool</span></div>\n        <div class=\"step\" data-step=\"3\"><span class=\"num\">03</span><span class=\"label\">Synthesizing answer</span></div>\n      </div>\n      <div id=\"toolStageMsg\" class=\"stage-line\"><span class=\"spinner\"></span> Working\u2026</div>\n    `;\n    toolPanel.innerHTML = stepsHtml;\n    const stepEls = toolPanel.querySelectorAll('.step');\n\n    function setStep(n){\n      stepEls.forEach(s=>{\n        const idx = parseInt(s.dataset.step,10);\n        s.classList.toggle('active', idx === n);\n        s.classList.toggle('done', idx < n);\n      });\n    }\n    setStep(1);\n\n    setTimeout(()=>{\n      setStep(2);\n      document.getElementById('toolStageMsg').innerHTML = `<span class=\"spinner\"></span> Calling external search tool\u2026`;\n\n      setTimeout(()=>{\n        setStep(3);\n        document.getElementById('toolStageMsg').innerHTML = `<span class=\"spinner\"></span> Synthesizing an answer from search results\u2026`;\n\n        setTimeout(()=>{\n          const key = query.toLowerCase();\n          const results = searchFixtures[key] || fallbackResults(query);\n          const resultsHtml = results.map((r,idx)=>`\n            <div class=\"result-item\">\n              <div class=\"rank-badge\">${idx+1}</div>\n              <div>\n                <h5>${r.title}</h5>\n                <p>${r.summary}</p>\n                <span class=\"source-label\">Source: ${r.source}</span>\n              </div>\n            </div>\n          `).join('');\n\n          const synthesized = `Based on ${results.length} search results, ${results[0].summary.charAt(0).toLowerCase()+results[0].summary.slice(1)}`;\n\n          toolPanel.innerHTML = `\n            <div class=\"answer-card\">\n              <div class=\"routing-line\">\u21b3 routed to: Search Tool (Tool_Use_Integration)</div>\n              <div class=\"answer-meta\">\n                <span class=\"tag dot\">Query: \u201c${query}\u201d</span>\n                <span class=\"confidence high\">Grounded in ${results.length} live search result(s)</span>\n              </div>\n              <div class=\"answer-text\">${synthesized}</div>\n              <div class=\"passages-block\">\n                <h5>Search results used</h5>\n                <div class=\"result-list\">${resultsHtml}</div>\n              </div>\n            </div>\n          `;\n          submitBtn.disabled = false;\n          bump('search', 1);\n          pushLog('Tool-Use Example App', 'Search tool', `Looked up: \u201c${query.slice(0,40)}${query.length>40?'\u2026':''}\u201d`);\n        }, 700);\n      }, 750);\n    }, 600);\n  });\n\n  /* ================= FRAMEWORK SERVICES CONSOLE ================= */\n  const reqType = document.getElementById('reqType');\n  const reqPayload = document.getElementById('reqPayload');\n  const sendReqBtn = document.getElementById('sendReq');\n  const responseBox = document.getElementById('responseBox');\n  const simulateLimitBtn = document.getElementById('simulateLimit');\n\n  const placeholders = {\n    generation: 'Summarize how BWS4 uses Spec4 to teach agentic patterns.',\n    representation: 'Voyager 1 launched in 1977 and entered interstellar space in 2012.',\n    storage: 'key: \"visitor_last_question\" value: \"What is the James Webb Space Telescope?\"'\n  };\n  reqType.addEventListener('change', ()=>{\n    reqPayload.placeholder = placeholders[reqType.value];\n  });\n\n  const storedRecords = [\n    { key:'visitor_last_question', value:'What did the Apollo 11 mission accomplish?', writtenBy:'RAG Example App' }\n  ];\n\n  sendReqBtn.addEventListener('click', ()=>{\n    const type = reqType.value;\n    const payload = reqPayload.value.trim() || placeholders[type];\n    const capKey = type === 'generation' ? 'generation' : type === 'representation' ? 'representation' : 'storage';\n\n    if(isExhausted(capKey)){\n      responseBox.classList.add('err');\n      responseBox.textContent = `\u26a0 Request rejected: \"${usage[capKey].label}\" has reached its free-tier limit (${usage[capKey].used}/${usage[capKey].cap}). This is the same clear-failure behavior every example app sees when a shared capability is exhausted.`;\n      return;\n    }\n    responseBox.classList.remove('err');\n    responseBox.textContent = 'Sending request to shared framework services\u2026';\n\n    setTimeout(()=>{\n      let out;\n      if(type === 'generation'){\n        out = `[LanguageGenerationRequest \u2192 response]\\nprompt: \"${payload}\"\\n\\n\u2192 \"BWS4 pairs a small set of teaching-oriented example apps \u2014 RAG, tool use, and more \u2014 with shared services for generation, representation, and storage, all implemented using Spec4 itself so the framework's own build doubles as the demonstration.\"`;\n      } else if(type === 'representation'){\n        const fakeVec = Array.from({length:6}, ()=> (Math.random()*2-1).toFixed(3)).join(', ');\n        out = `[TextRepresentation \u2192 response]\\nsourceText: \"${payload}\"\\n\\nvectorPreview: [${fakeVec}, ...]\\ndimensions: 768`;\n      } else {\n        storedRecords.push({ key:`console_test_${storedRecords.length+1}`, value: payload, writtenBy:'Framework Console' });\n        const latest = storedRecords.slice(-3).map(r=>`  { key: \"${r.key}\", value: \"${r.value.slice(0,42)}${r.value.length>42?'\u2026':''}\", writtenBy: \"${r.writtenBy}\" }`).join('\\n');\n        out = `[StoredRecord \u2192 write + retrieve]\\nwritten: { key: \"console_test_${storedRecords.length}\", value: \"${payload.slice(0,42)}${payload.length>42?'\u2026':''}\" }\\n\\nrecent records available to all apps:\\n${latest}`;\n      }\n      responseBox.textContent = out;\n      bump(capKey, type === 'storage' ? 1 : 2);\n      pushLog('Framework Console', usage[capKey].label, `Manual test request (${type})`);\n    }, 500);\n  });\n\n  simulateLimitBtn.addEventListener('click', ()=>{\n    const capKey = reqType.value === 'generation' ? 'generation' : reqType.value === 'representation' ? 'representation' : 'storage';\n    usage[capKey].used = usage[capKey].cap;\n    renderUsage();\n    responseBox.classList.add('err');\n    responseBox.textContent = `\u26a0 Simulated: \"${usage[capKey].label}\" usage limit has been forced to ${usage[capKey].cap}/${usage[capKey].cap}. Send a request now to see the clear-failure message every app would receive.`;\n  });\n\n})();\n</script>\n</body>\n</html>",
  "finalized": true
}