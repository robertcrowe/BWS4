  "screens": [
    {
      "id": "screen-landing",
      "audience": "Developers evaluating Spec4 / learning agentic patterns",
      "purpose": "Introduce BWS4, state Spec4 provenance, and present the catalog of example apps (Embeddings, Single-Call, RAG, Tool-Use, Chained-Calls, Planning Agent).",
      "surfaces": [
        "landing_intro",
        "app_catalog"
      ]
    },
    {
      "id": "screen-rag",
      "audience": "Developers learning the RAG pattern",
      "purpose": "Demonstrate retrieval-augmented generation over a small visible dataset.",
      "surfaces": [
        "rag_dataset_browser",
        "rag_question_form",
        "rag_answer_panel"
      ]
    },
    {
      "id": "screen-tooluse",
      "audience": "Developers learning tool-use patterns",
      "purpose": "Demonstrate an agent calling a live search tool mid-response.",
      "surfaces": [
        "tool_query_form",
        "tool_run_panel"
      ]
    },
    {
      "id": "screen-singlecall",
      "audience": "Developers learning the single-call pattern",
      "purpose": "Demonstrate one prompt in, one response out, in simple and structured modes.",
      "surfaces": [
        "sc_overview",
        "sc_prompt_form",
        "sc_result_panel"
      ]
    },
    {
      "id": "screen-chained",
      "audience": "Developers learning the chained-calls pattern",
      "purpose": "Demonstrate exactly two sequential model calls (writer \u2192 critic) with visible hand-off.",
      "surfaces": [
        "chained_overview",
        "chained_prompt_form",
        "chained_result_panel"
      ]
    },
    {
      "id": "screen-planning",
      "audience": "Developers learning the planning-agent pattern",
      "purpose": "Demonstrate goal decomposition into a visible plan, explicit user go-ahead, sequential executor steps, and a final itinerary under strict quota limits.",
      "surfaces": [
        "plan_overview",
        "plan_goal_form",
        "plan_review_execute_panel"
      ]
    },
    {
      "id": "screen-embeddings",
      "audience": "Developers learning about embeddings",
      "purpose": "Visualize semantic clustering of curated texts and let users add their own text to the plot.",
      "surfaces": [
        "embed_overview",
        "embed_custom_text_form",
        "embed_plot",
        "embed_placement_panel"
      ]
    },
    {
      "id": "screen-console",
      "audience": "Spec4 team / maintainers",
      "purpose": "Test the shared framework services directly, watch usage limits, and view the cross-app request log (reachable via hamburger menu only; no landing-page card).",
      "surfaces": [
        "console_request_tester",
        "console_usage_limits",
        "console_request_log"
      ]
    }
  ],
