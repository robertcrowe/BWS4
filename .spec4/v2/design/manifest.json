    {
      "name": "custom_text_semantic_placement",
      "kind": "ai",
      "screen": "screen-embeddings",
      "implements_features": [
        "embeddings_example_app"
      ],
      "affordance": "form submit -> loading -> new distinct-colored point merged into existing plot + nearest-neighbor list",
      "invocation": {
        "trigger": "User submits custom text in the Embeddings Example App (preset examples are embedded and projected once at build/deploy time, not per-request)",
        "mode": "synchronous"
      },
      "catalog_surface": "custom_text_semantic_placement",
      "inputs": [
        "custom text input",
        "preset suggestion chips"
      ],
      "output": "New point rendered in a distinct color/shape on the shared plot, plus its nearest preset neighbors and distances",
      "states": [
        "idle",
        "embedding",
        "placed-in-cluster",
        "no-strong-match",
        "service-unavailable"
      ],
      "reads": [
        "EmbeddingPoint",
        "Projection"
      ],
      "writes": [
        "EmbeddingPoint",
        "UsageLimit",
        "ServiceLogEntry"
      ],
      "depends_on": [
        "embeddings_plot"
      ],
      "catalog_surface_id": "custom_text_semantic_placement",
      "implements_feature_ids": [
        "embeddings_example_app"
      ]
