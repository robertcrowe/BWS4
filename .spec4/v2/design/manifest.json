  "screens": [
    {
      "id": "screen-landing",
      "audience": "developers evaluating Spec4 / learners",
      "purpose": "Introduce BWS4, state Spec4 provenance, list all example apps",
      "surfaces": [
        "app_directory_listing"
      ]
    },
    {
      "id": "screen-rag",
      "audience": "developers learning agentic patterns",
      "purpose": "Demonstrate retrieval-augmented generation end-to-end",
      "surfaces": [
        "dataset_browser",
        "rag_example_app"
      ]
    },
    {
      "id": "screen-tooluse",
      "audience": "developers learning agentic patterns",
      "purpose": "Demonstrate tool-use / function calling via a live search step",
      "surfaces": [
        "tool_use_example_app"
      ]
    },
    {
      "id": "screen-singlecall",
      "audience": "developers learning agentic patterns",
      "purpose": "Demonstrate the single-call pattern in plain and structured response modes",
      "surfaces": [
        "single_call_explainer",
        "single_call_generation"
      ]
    },
    {
      "id": "screen-embeddings",
      "audience": "developers learning agentic patterns",
      "purpose": "Visualize semantic clustering of preset text and placement of custom text",
      "surfaces": [
        "embeddings_explainer",
        "embeddings_plot",
        "custom_text_semantic_placement"
      ]
    },
    {
      "id": "screen-console",
      "audience": "Spec4 team / maintainers",
      "purpose": "Inspect and exercise shared framework services directly",
      "surfaces": [
        "service_request_tester",
        "usage_limit_display",
        "cross_app_request_log"
      ]
    }
  ],
  "surfaces": [
    {
      "name": "app_directory_listing",
      "kind": "non_ai",
      "screen": "screen-landing",
      "implements_features": [
        "Landing_Page"
      ],
      "inputs": [],
      "output": "Grid of app cards with name, description, tag, and open action (or 'coming soon')",
      "states": [
        "default"
      ],
      "reads": [
        "ExampleApp"
      ],
      "writes": [],
      "depends_on": [],
      "implements_feature_ids": [
        "landing_page"
      ]
    },
    {
      "name": "dataset_browser",
      "kind": "non_ai",
      "screen": "screen-rag",
      "implements_features": [
        "RAG_Example_App"
      ],
      "inputs": [
        "expand/collapse toggle per document"
      ],
      "output": "Expandable list of the 5 reference documents",
      "states": [
        "collapsed",
        "expanded"
      ],
      "reads": [
        "Dataset"
      ],
      "writes": [],
      "depends_on": [],
      "implements_feature_ids": [
        "rag_example_app"
      ]
    },
    {
      "name": "rag_example_app",
      "kind": "ai",
      "screen": "screen-rag",
      "implements_features": [
        "rag_example_app"
      ],
      "affordance": "form submit -> staged retrieval then generation, answer + passages rendered",
      "invocation": {
        "trigger": "A visitor opens the RAG example app from the landing page and submits a natural-language question",
        "mode": "synchronous"
      },
      "catalog_surface": "rag_example_app",
      "inputs": [
        "question text input",
        "preset question chips"
      ],
      "output": "Generated answer with citations plus list of retrieved passages and match scores",
      "states": [
        "idle",
        "retrieving",
        "generating",
        "low-confidence/dataset-gap",
        "service-unavailable"
      ],
      "reads": [
        "Dataset",
        "Query"
      ],
      "writes": [
        "Answer",
        "RetrievedPassage",
        "UsageLimit",
        "ServiceLogEntry"
      ],
      "depends_on": [
        "dataset_browser"
      ],
      "catalog_surface_id": "rag_example_app",
      "implements_feature_ids": [
        "rag_example_app"
      ]
    },
    {
      "name": "tool_use_example_app",
      "kind": "ai",
      "screen": "screen-tooluse",
      "implements_features": [
        "Tool_Use_Integration"
      ],
      "affordance": "multi-step progress (parse -> search -> synthesize) then answer + result list",
      "invocation": "Visitor submits a live-lookup query (typed or preset chip)",
      "catalog_surface": "tool_use_example_app",
      "inputs": [
        "query text input",
        "preset query chips"
      ],
      "output": "Synthesized answer citing live search results, with routing indicator",
      "states": [
        "idle",
        "parsing",
        "searching",
        "synthesizing",
        "tool-unavailable"
      ],
      "reads": [
        "Query"
      ],
      "writes": [
        "SearchResult",
        "Answer",
        "UsageLimit",
        "ServiceLogEntry"
      ],
      "depends_on": [],
      "catalog_surface_id": "tool_use_example_app",
      "implements_feature_ids": [
        "tool_use_integration"
      ]
    },
    {
      "name": "single_call_explainer",
      "kind": "non_ai",
      "screen": "screen-singlecall",
      "implements_features": [
        "Single_Call_Example_App"
      ],
      "inputs": [],
      "output": "Short explanation of the single-call pattern and when it's appropriate",
      "states": [
        "default"
      ],
      "reads": [],
      "writes": [],
      "depends_on": [],
      "implements_feature_ids": [
        "single_call_example_app"
      ]
    },
    {
      "name": "single_call_generation",
      "kind": "ai",
      "screen": "screen-singlecall",
      "implements_features": [
        "single_call_example_app"
      ],
      "affordance": "preset chips + prompt textarea + mode toggle (Simple/Structured) + submit -> single response shown; structured mode shows request+response side by side with conformance check",
      "invocation": {
        "trigger": "User enters or selects a preset prompt, chooses a response mode (plain or structured), and submits the form.",
        "mode": "synchronous"
      },
      "catalog_surface": "single_call_generation",
      "inputs": [
        "preset prompt chips (labeled by intent: summarize/classify/extract)",
        "free-text prompt textarea",
        "mode toggle (Simple/Structured)"
      ],
      "output": "Simple mode: plain-text answer. Structured mode: request payload and schema-conforming (or flagged non-conforming) JSON response shown together",
      "states": [
        "idle",
        "blocked-empty-prompt",
        "loading",
        "simple-result",
        "structured-result-conforming",
        "structured-result-mismatch",
        "service-unavailable"
      ],
      "reads": [
        "PresetPrompt",
        "Prompt"
      ],
      "writes": [
        "Response",
        "UsageLimit",
        "ServiceLogEntry"
      ],
      "depends_on": [],
      "catalog_surface_id": "single_call_generation",
      "implements_feature_ids": [
        "single_call_example_app"
      ]
    },
    {
      "name": "embeddings_explainer",
