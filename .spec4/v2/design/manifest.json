      "kind": "non_ai",
      "screen": "screen-embeddings",
      "implements_features": [
        "Embeddings_Example_App"
      ],
      "inputs": [],
      "output": "Fixed 2D SVG scatter of 24 preset texts across 4 categories, with legend",
      "states": [
        "default",
        "with-custom-points"
      ],
      "reads": [
        "TextSample",
        "EmbeddingPoint",
        "Projection"
      ],
      "writes": [],
      "depends_on": [],
      "implements_feature_ids": [
