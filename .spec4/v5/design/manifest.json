  "screens": [
    {
      "id": "screen-landing",
      "audience": "Developers evaluating Spec4 / learning agentic patterns",
      "purpose": "Introduce BWS4, explain it was built with Spec4, and present the catalogue of example apps.",
      "surfaces": [
        "project_introduction",
        "example_app_catalogue"
      ]
    },
    {
      "id": "screen-rag",
      "audience": "Developers learning the RAG pattern",
      "purpose": "Demonstrate retrieval-augmented generation over a small public dataset with retrieval and generation visible as distinct stages.",
      "surfaces": [
        "rag_dataset_browser",
        "rag_question_form"
      ]
    },
    {
      "id": "screen-tooluse",
      "audience": "Developers learning tool use / function calling",
      "purpose": "Show an agent calling a shared web search tool mid-response and synthesizing an answer from the findings.",
      "surfaces": [
        "tool_use_query_runner"
      ]
    },
    {
      "id": "screen-singlecall",
      "audience": "Developers learning the single-call pattern",
      "purpose": "Show one prompt in, one response out, in both plain and schema-conforming structured modes.",
      "surfaces": [
        "single_call_overview",
        "single_call_runner"
      ]
    },
    {
      "id": "screen-chained",
      "audience": "Developers learning chained calls",
      "purpose": "Show a two-step chain where the writer's draft becomes the critic's input, with both outputs visible.",
      "surfaces": [
        "chained_calls_overview",
        "chained_calls_runner"
      ]
    },
    {
      "id": "screen-planning",
      "audience": "Developers learning the planning-agent pattern",
      "purpose": "Show a planner call decomposing a goal into a visible plan, then executing steps after explicit confirmation.",
      "surfaces": [
        "planning_overview",
        "planning_goal_form",
        "planning_execution_runner"
      ]
    },
    {
      "id": "screen-orchestrated",
      "audience": "Developers learning orchestrated subagents",
      "purpose": "Show a coordinator choosing two specialists from a fixed roster, briefing them, running them side by side, and merging their answers.",
      "surfaces": [
        "orchestrated_overview",
        "specialist_roster_panel",
        "orchestrated_question_form",
        "orchestrated_delegation_review",
        "orchestrated_parallel_execution",
        "orchestrated_merged_answer"
      ]
    },
    {
      "id": "screen-embeddings",
      "audience": "Developers learning embeddings",
      "purpose": "Make embeddings tangible with a 2D semantic plot of curated texts plus visitor-added text.",
      "surfaces": [
        "embeddings_overview",
        "embeddings_plot",
        "embeddings_custom_text_form"
      ]
    },
    {
      "id": "screen-console",
      "audience": "Spec4 team / maintainers",
      "purpose": "Exercise the shared framework services directly, watch usage limits, and view a cross-app request log.",
      "surfaces": [
        "service_request_tester",
        "usage_limits_panel",
        "cross_app_request_log"
      ]
    }
  ],
