  "screens": [
    {
      "id": "screen-landing",
      "audience": "Visitors / developers evaluating Spec4",
      "purpose": "Introduce BWS4, state it was built with Spec4, and list every example app in order of increasing pattern complexity.",
      "surfaces": [
        "project_intro",
        "example_catalogue"
      ]
    },
    {
      "id": "screen-rag",
      "audience": "Developers learning agentic patterns",
      "purpose": "Demonstrate retrieval-augmented generation over a small public dataset with visible retrieval and generation stages.",
      "surfaces": [
        "rag_dataset_browser",
        "rag_question_form",
        "rag_grounded_answer"
      ]
    },
    {
      "id": "screen-tooluse",
      "audience": "Developers learning agentic patterns",
      "purpose": "Demonstrate tool use / function calling with a shared web search capability.",
      "surfaces": [
        "tooluse_query_form",
        "tooluse_agent_run"
      ]
    },
    {
      "id": "screen-singlecall",
      "audience": "Developers learning agentic patterns",
      "purpose": "Demonstrate the single-call pattern in plain and structured modes.",
      "surfaces": [
        "singlecall_overview",
        "singlecall_prompt_form",
        "singlecall_response"
      ]
    },
    {
      "id": "screen-chained",
      "audience": "Developers learning agentic patterns",
      "purpose": "Demonstrate two sequential model calls where the first output becomes the second input.",
      "surfaces": [
        "chained_overview",
        "chained_prompt_form",
        "chained_stage_results"
      ]
    },
    {
      "id": "screen-planning",
      "audience": "Developers learning agentic patterns",
      "purpose": "Demonstrate a planning agent that decomposes a goal into a reviewable plan then executes it.",
      "surfaces": [
        "planning_overview",
        "planning_goal_form",
        "planning_plan_review",
        "planning_execution"
      ]
    },
    {
      "id": "screen-orchestrated",
      "audience": "Developers learning agentic patterns",
      "purpose": "Demonstrate fan-out/fan-in orchestration of two of four fixed specialists with a visible delegation decision.",
      "surfaces": [
        "orchestrated_overview",
        "specialist_roster",
        "orchestrated_question_form",
        "orchestrated_delegation_decision",
        "orchestrated_parallel_execution",
        "orchestrated_merged_answer"
      ]
    },
    {
      "id": "screen-collab",
      "audience": "Developers learning agentic patterns",
      "purpose": "Demonstrate peer-to-peer multi-agent collaboration through a competitive procurement negotiation across a code-enforced opacity boundary.",
      "surfaces": [
        "collab_overview",
        "collab_identity_cards",
        "collab_scenario_form",
        "collab_negotiation_run",
        "collab_message_log",
        "collab_private_reveal",
        "collab_priority_sensitivity"
      ]
    },
    {
      "id": "screen-embeddings",
      "audience": "Developers learning agentic patterns",
      "purpose": "Demonstrate embeddings by plotting curated texts in 2D and placing visitor-supplied text in the same space.",
      "surfaces": [
        "embeddings_overview",
        "embeddings_plot",
        "embeddings_custom_text_form",
        "embeddings_placement_result"
      ]
    },
    {
      "id": "screen-console",
      "audience": "Spec4 team / maintainers",
      "purpose": "Exercise the shared framework services directly, watch usage allowances move, and see cross-app request logs.",
      "surfaces": [
        "services_request_tester",
        "usage_allowance_panel",
        "cross_app_request_log"
      ]
    }
  ],
