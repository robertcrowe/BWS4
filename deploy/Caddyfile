# Built with Spec4 AI - https://spec4.ai
#
# BWS4 public edge — Caddy 2 site configuration.
#
# Phase 6 note: the canonical hostname bw.spec4.ai is served here. It is
# added as a SECOND ADDRESS on the already-validated site block rather
# than as a transcribed copy of it, deliberately: Caddy treats each
# address as its own site (own certificate, own HTTP→HTTPS redirect), so
# this satisfies "both hostnames answer during DNS propagation" while
# making it structurally impossible for the canonical site's config to
# drift from the one Phase 3–5 validated — the transcription slip that
# would silently reintroduce SSE buffering cannot be written this way.
# Once the canonical origin is confirmed healthy, retiring the temporary
# validation hostname is deleting "bwtemp.spec4.ai" from the address
# line, leaving exactly one site. No wildcard/catch-all host matcher:
# the edge answers only for hostnames we have deliberately placed here.
#
# TLS is automatic HTTPS, not manual configuration: because the site
# address is a real hostname, Caddy issues the Let's Encrypt certificate
# itself, installs the HTTP→HTTPS redirect on port 80, and renews the
# certificate in-process. Renewal is delegated to the server rather than
# to an external timer (certbot cron etc.) so an expired certificate is
# structurally hard rather than merely automated — there is no separate
# moving part whose silent failure lets the cert lapse.
#
# No HTTP Basic auth, IP allowlist or other access control appears here
# by design: the application has no accounts or authentication, and abuse
# is bounded by the server-side usage caps, not by identity.
bw.spec4.ai, bwtemp.spec4.ai {
	# Ordered handle blocks: the API and the static SPA must never
	# contend for a path. handle blocks are mutually exclusive and
	# matched in the order written, so /api/* is claimed first and the
	# final unmatched block owns everything else.
	handle /api/* {
		# NO `encode` directive in this block, deliberately: gzip/zstd
		# over a server-sent-event stream is a second, independent way
		# to reintroduce buffering even with flush_interval set.
		# Compression is applied only to the static block below.
		reverse_proxy 127.0.0.1:8000 {
			# Explicit, not redundant: Caddy auto-disables response
			# buffering only when it detects a Content-Type of exactly
			# text/event-stream, and there are documented cases where a
			# charset suffix or unflushed headers defeat that detection.
			# That failure is silent — the four SSE apps (ReAct loop's
			# cycle-by-cycle trace, the planning agent's per-step
			# results, the orchestrated subagents' per-specialist
			# events, the collaboration app's per-stage events) would
			# still "work" while delivering every event in one burst at
			# stream close, destroying the progressive behaviour those
			# demonstrations exist to show. A negative flush_interval
			# selects low-latency mode: flush after every write.
			flush_interval -1
		}
	}

	# The backend liveness endpoint lives OUTSIDE the /api prefix
	# (GET /health, backend/app/api/health.py), so it needs its own
	# proxy block to stay reachable through the edge independently of
	# the SPA. Known, deliberate consequence: the SPA also defines a
	# client-side /health route (HealthScreen); on this single origin
	# the backend wins and that screen is no longer reachable as a deep
	# link. The screen's own fetch of /health still resolves correctly.
	handle /health {
		reverse_proxy 127.0.0.1:8000
	}

	# Hashed bundle assets get their own block, for two reasons found the
	# hard way during the Phase 5 acceptance pass. First, caching: Vite
	# content-hashes every filename in assets/, so a given URL can never
	# change meaning and may be cached forever — while WITHOUT an explicit
	# Cache-Control anywhere, browsers fall back to heuristic freshness on
	# index.html itself and can keep serving a stale entry chunk for hours
	# after a deploy. Second, fallback scope: assets/ must NOT fall back to
	# /index.html — a chunk that no longer exists after a redeploy must be
	# a 404, exactly as Render served it. With the fallback in place the
	# browser received index.html AS the module ("Failed to fetch
	# dynamically imported module"), which broke every route navigation
	# for any visitor holding a pre-deploy index.html.
	handle /assets/* {
		root * /srv/bws4/frontend/dist
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the SPA shell. try_files falls back to
	# /index.html for any path that is not a real file, which is what
	# makes deep links to example-app routes (/react, /collab, …)
	# resolve to the bundle so React Router can route them client-side.
	# no-cache does NOT mean "don't store": it means revalidate before
	# reuse, so every navigation re-checks index.html against its etag
	# (matching the max-age=0 revalidation behaviour Render gave the
	# gallery) and a fresh deploy is picked up on the next full load.
	handle {
		root * /srv/bws4/frontend/dist
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
